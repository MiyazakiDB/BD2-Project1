import os
import numpy as np
import librosa
from sklearn.metrics.pairwise import cosine_similarity
from pathlib import Path
import heapq

class MFCCComparator:
    def __init__(self, directory_path, n_mfcc=13, sr=22050):
        """
        Inicializa el comparador de MFCCs
        
        Args:
            directory_path: Directorio con archivos de audio
            n_mfcc: Número de coeficientes MFCC
            sr: Sample rate
        """
        self.directory_path = Path(directory_path)
        self.n_mfcc = n_mfcc
        self.sr = sr
        self.audio_mfccs = {}  # Diccionario: {filename: mfcc_vector}
        self.filenames = []
        
        print(f"Inicializando comparador MFCC...")
        print(f"Directorio: {self.directory_path}")
        print(f"N_MFCC: {self.n_mfcc}, Sample Rate: {self.sr}")
        
        # Calcular MFCCs de todos los audios del directorio
        self._calculate_all_mfccs()
    
    def extract_mfcc_from_file(self, file_path):
        """Extrae MFCCs de un archivo de audio"""
        try:
            y, sr = librosa.load(file_path, sr=self.sr)
            mfcc = librosa.feature.mfcc(y=y, sr=sr, n_mfcc=self.n_mfcc)
            
            # Calcular estadísticas de los MFCCs para tener un vector fijo
            mfcc_mean = np.mean(mfcc, axis=1)  # Media de cada coeficiente
            mfcc_std = np.std(mfcc, axis=1)    # Desviación estándar
            
            # Concatenar mean y std para tener un vector de características fijo
            feature_vector = np.concatenate([mfcc_mean, mfcc_std])
            
            return feature_vector
            
        except Exception as e:
            print(f"Error procesando {file_path}: {e}")
            return None
    
    def _calculate_all_mfccs(self):
        """Calcula MFCCs de todos los archivos en el directorio"""
        print("Calculando MFCCs de todos los audios...")
        
        # Extensiones de audio soportadas
        audio_extensions = {'.wav', '.mp3', '.m4a', '.flac', '.ogg'}
        
        audio_files = [f for f in self.directory_path.iterdir() 
                      if f.suffix.lower() in audio_extensions]
        
        if not audio_files:
            print(f"No se encontraron archivos de audio en {self.directory_path}")
            return
        
        successful_extractions = 0
        
        for audio_file in audio_files:
            print(f"Procesando: {audio_file.name}")
            
            mfcc_vector = self.extract_mfcc_from_file(audio_file)
            
            if mfcc_vector is not None:
                self.audio_mfccs[audio_file.name] = mfcc_vector
                self.filenames.append(audio_file.name)
                successful_extractions += 1
        
        print(f"MFCCs calculados exitosamente: {successful_extractions}/{len(audio_files)}")
        print(f"Dimensión del vector MFCC: {len(list(self.audio_mfccs.values())[0]) if self.audio_mfccs else 0}")
    
    def find_similar_audios(self, query_audio_path, top_k=10):
        """
        Encuentra audios similares al audio de consulta
        
        Args:
            query_audio_path: Ruta del audio de consulta
            top_k: Número de resultados más similares a retornar
        
        Returns:
            Lista de tuplas (filename, similarity_score)
        """
        if not self.audio_mfccs:
            print("No hay MFCCs calculados en el directorio")
            return []
        
        print(f"Analizando audio de consulta: {Path(query_audio_path).name}")
        
        # Extraer MFCC del audio de consulta
        query_mfcc = self.extract_mfcc_from_file(query_audio_path)
        
        if query_mfcc is None:
            print("Error: No se pudo extraer MFCC del audio de consulta")
            return []
        
        # Convertir MFCCs del directorio a matriz
        database_mfccs = np.array(list(self.audio_mfccs.values()))
        
        # Calcular similitud coseno
        similarities = cosine_similarity([query_mfcc], database_mfccs)[0]
        
        # Crear heap para obtener los top_k más similares
        heap = []
        for i, similarity in enumerate(similarities):
            filename = self.filenames[i]
            # Usar similitud negativa para simular max-heap
            heapq.heappush(heap, (-similarity, filename, similarity))
        
        # Extraer los top_k resultados
        results = []
        num_results = min(top_k, len(heap)) if top_k else len(heap)
        
        for _ in range(num_results):
            if heap:
                neg_sim, filename, similarity = heapq.heappop(heap)
                results.append((filename, similarity))
        
        return results
    
    def show_statistics(self):
        """Muestra estadísticas del dataset"""
        if not self.audio_mfccs:
            print("No hay datos para mostrar estadísticas")
            return
        
        print(f"\n=== ESTADÍSTICAS DEL DATASET ===")
        print(f"Total de audios procesados: {len(self.audio_mfccs)}")
        print(f"Dimensión de vectores MFCC: {len(list(self.audio_mfccs.values())[0])}")
        print(f"Archivos en el dataset:")
        for i, filename in enumerate(self.filenames[:10], 1):  # Mostrar primeros 10
            print(f"  {i}. {filename}")
        if len(self.filenames) > 10:
            print(f"  ... y {len(self.filenames) - 10} más")

def main():
    """Función principal para demostrar el uso"""
    
    # === CONFIGURACIÓN ===
    DIRECTORY_PATH = r"C:\Users\tokio\OneDrive\Escritorio\BD2-Project1\MFCC-BETA\previews"
    QUERY_AUDIO_PATH = r"C:\Users\tokio\OneDrive\Escritorio\BD2-Project1\MFCC-BETA\audio_to_see\STROKESPRUEBA.mp3"
    TOP_K = 10  # Número de resultados más similares
    
    # === INICIALIZAR COMPARADOR ===
    comparator = MFCCComparator(DIRECTORY_PATH)
    
    # Mostrar estadísticas
    comparator.show_statistics()
    
    # === BUSCAR AUDIOS SIMILARES ===
    if Path(QUERY_AUDIO_PATH).exists():
        print(f"\n=== BÚSQUEDA DE SIMILITUD ===")
        resultados = comparator.find_similar_audios(QUERY_AUDIO_PATH, top_k=TOP_K)
        
        if resultados:
            print(f"\nAudios más similares a {Path(QUERY_AUDIO_PATH).name}:")
            print("-" * 80)
            
            for i, (filename, similarity) in enumerate(resultados, 1):
                print(f"{i:2d}. {filename:<50} | Similitud: {similarity:.6f}")
            
            # Estadísticas de similitud
            similarities = [sim for _, sim in resultados]
            print(f"\n=== ESTADÍSTICAS DE SIMILITUD ===")
            print(f"Similitud máxima: {max(similarities):.6f}")
            print(f"Similitud mínima: {min(similarities):.6f}")
            print(f"Similitud promedio: {np.mean(similarities):.6f}")
        else:
            print("No se encontraron resultados")
    else:
        print(f"Error: No se encuentra el archivo de consulta: {QUERY_AUDIO_PATH}")

if __name__ == "__main__":
    main()